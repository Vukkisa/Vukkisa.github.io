{
  "name": "vukkisa-portfolio",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "Jayanth Vukkisa — AI & Data Science portfolio. Source lives in app/, the build is written to the repo root for GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && rm -rf static && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run build && npm run size && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "og": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "gpt-tokenizer": "4.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.5"
  }
}
